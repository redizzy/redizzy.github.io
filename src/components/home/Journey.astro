---
const milestones = [
  {
    index: "01",
    phase: "Foundation",
    title: "Mathematics at HFUT",
    desc: "Building a rigorous foundation through analysis, algebra, probability, and the habit of reasoning from first principles.",
    tags: ["Theory", "Abstraction", "Probability"],
  },
  {
    index: "02",
    phase: "Applied research",
    title: "GAANet",
    desc: "Turning mathematical and engineering ideas into an audio-visual speech separation system with global-guided attention.",
    tags: ["Multimodal AI", "PyTorch", "Research"],
  },
  {
    index: "03",
    phase: "Current direction",
    title: "Toward Data Science",
    desc: "Connecting statistics, machine learning, and software practice through increasingly complete real-world projects.",
    tags: ["Statistics", "ML", "Engineering"],
  },
];
---

<section id="journey" class="journey-section relative overflow-hidden text-slate-950">
  <div class="journey-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <div class="journey-glow pointer-events-none absolute -left-40 top-20 h-[30rem] w-[30rem] rounded-full bg-blue-600/15 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:py-32">
    <div class="grid gap-10 lg:grid-cols-[0.7fr_1.3fr] lg:gap-20">
      <div>
        <div class="mb-4 flex items-center gap-3 font-mono text-[0.65rem] font-bold uppercase tracking-[0.24em] text-blue-600">
          <span>03</span>
          <span class="h-px w-10 bg-blue-600"></span>
          The journey
        </div>
        <h2 class="text-4xl font-black leading-[0.98] tracking-[-0.045em] sm:text-5xl lg:text-6xl">
          Learn.<br />Build.<br /><span class="text-blue-600">Refine.</span>
        </h2>
        <p class="mt-7 max-w-md text-base leading-7 text-slate-600 lg:text-lg lg:leading-8">
          The path is not a list of finished titles. It is a loop: understand a concept, test it in
          practice, and return with better questions.
        </p>

        <div class="mt-10 hidden max-w-sm border-t border-slate-200 pt-6 lg:block">
          <div class="flex items-center justify-between font-mono text-[0.6rem] uppercase tracking-[0.18em] text-slate-400">
            <span>Foundation</span>
            <span>Direction</span>
          </div>
          <div class="mt-3 flex items-center">
            <span class="h-2 w-2 rounded-full bg-slate-300"></span>
            <span class="h-px flex-1 bg-gradient-to-r from-slate-300 via-blue-400 to-blue-600"></span>
            <span class="current-point relative h-2.5 w-2.5 rounded-full bg-blue-600"></span>
          </div>
        </div>
      </div>

      <div class="relative">
        <div class="timeline-line absolute bottom-10 left-[1.15rem] top-10 w-px bg-gradient-to-b from-slate-300 via-blue-300 to-blue-600 sm:left-[1.4rem]" aria-hidden="true"></div>
        <ol class="space-y-5">
          {
            milestones.map(({ index, phase, title, desc, tags }, milestoneIndex) => (
              <li class="milestone group relative grid grid-cols-[2.4rem_1fr] gap-4 sm:grid-cols-[3rem_1fr] sm:gap-6">
                <div class="relative z-10 pt-7">
                  <span class:list={[
                    "milestone-dot grid h-9 w-9 place-items-center rounded-full border font-mono text-[0.6rem] font-black transition sm:h-11 sm:w-11",
                    milestoneIndex === milestones.length - 1
                      ? "border-blue-600 bg-blue-600 text-white shadow-lg shadow-blue-500/20"
                      : "border-slate-300 bg-white text-slate-500 group-hover:border-blue-400 group-hover:text-blue-600",
                  ]}>
                    {index}
                  </span>
                </div>

                <article class="milestone-card rounded-2xl border border-slate-200 bg-white/80 p-6 backdrop-blur-sm transition sm:p-7">
                  <div class="flex flex-wrap items-center justify-between gap-3">
                    <span class="font-mono text-[0.6rem] font-bold uppercase tracking-[0.2em] text-blue-600">{phase}</span>
                    {milestoneIndex === milestones.length - 1 && (
                      <span class="flex items-center gap-2 font-mono text-[0.55rem] uppercase tracking-[0.16em] text-slate-500">
                        <span class="relative h-1.5 w-1.5 rounded-full bg-blue-600 before:absolute before:inset-[-4px] before:animate-ping before:rounded-full before:border before:border-blue-500/50 before:content-[''] motion-reduce:before:animate-none"></span>
                        In progress
                      </span>
                    )}
                  </div>
                  <h3 class="mt-3 text-xl font-extrabold tracking-tight text-slate-950 sm:text-2xl">{title}</h3>
                  <p class="mt-3 max-w-2xl text-sm leading-6 text-slate-600 sm:text-base sm:leading-7">{desc}</p>
                  <div class="mt-5 flex flex-wrap gap-2">
                    {tags.map((tag) => <span class="journey-tag">{tag}</span>)}
                  </div>
                </article>
              </li>
            ))
          }
        </ol>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-5 border-t border-slate-200 pt-7 sm:flex-row sm:items-center lg:ml-[calc(35%+2rem)]">
      <p class="font-mono text-[0.65rem] uppercase tracking-[0.16em] text-slate-400">
        A living record, not a finished timeline.
      </p>
      <a href="/cv" class="group inline-flex items-center gap-2 text-sm font-extrabold text-slate-900 transition hover:text-blue-600">
        View the full CV
        <span class="transition-transform group-hover:translate-x-1">-&gt;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .journey-section {
    background: linear-gradient(180deg, #ffffff 0%, #f8fafc 18%, #eff6ff 100%);
  }

  .journey-grid {
    background-image:
      linear-gradient(rgb(71 85 105 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(71 85 105 / 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    mask-image: linear-gradient(to right, black, transparent 80%);
  }

  .milestone-card {
    transition: border-color 250ms ease, background-color 250ms ease, transform 250ms ease;
  }

  .milestone:hover .milestone-card {
    border-color: rgb(147 197 253 / 0.9);
    background: rgb(255 255 255 / 0.96);
    box-shadow: 0 22px 55px -40px rgb(15 23 42 / 0.4);
    transform: translateX(4px);
  }

  .journey-tag {
    border: 1px solid #dbe3ee;
    border-radius: 9999px;
    background: rgb(248 250 252 / 0.9);
    padding: 0.38rem 0.62rem;
    color: #64748b;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.6rem;
    font-weight: 700;
  }

  .current-point::after {
    position: absolute;
    inset: -0.45rem;
    border: 1px solid rgb(37 99 235 / 0.55);
    border-radius: 9999px;
    content: "";
    animation: journey-pulse 2s ease-out infinite;
  }

  @keyframes journey-pulse {
    from { opacity: 0.8; transform: scale(0.5); }
    to { opacity: 0; transform: scale(1.4); }
  }

  @media (prefers-reduced-motion: reduce) {
    .milestone-card,
    .milestone-dot,
    .current-point::after {
      animation: none;
      transition: none;
    }

    .milestone:hover .milestone-card {
      transform: none;
    }
  }
</style>
