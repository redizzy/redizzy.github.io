---
const identities = [
  "Undergraduate at HFUT",
  "Machine learning & software engineering",
  "Research ideas. Working software.",
  "Go player and pattern seeker",
];
---

<section id="home" class="hero-shell relative isolate min-h-[100svh] overflow-hidden pt-16">
  <div class="hero-grid pointer-events-none absolute inset-0 -z-20" aria-hidden="true"></div>
  <div class="hero-glow pointer-events-none absolute -z-10" aria-hidden="true"></div>

  <div class="mx-auto grid min-h-[calc(100svh-4rem)] w-full max-w-7xl items-center gap-14 px-6 py-16 sm:px-8 lg:grid-cols-[1.05fr_0.95fr] lg:gap-10 lg:py-20">
    <div class="relative z-10 max-w-3xl">
      <div class="mb-7 flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.24em] text-slate-500">
        <span class="h-px w-10 bg-blue-600"></span>
        Mathematics / Machine Learning / Software
      </div>

      <h1 class="whitespace-nowrap text-[clamp(2rem,5.5vw,4.5rem)] font-black leading-[1.05] tracking-[-0.055em] text-slate-950">
        Zhiyuan Zhang
      </h1>
      <p class="mt-6 max-w-2xl text-[clamp(1.65rem,3.2vw,3rem)] font-semibold leading-[1.08] tracking-[-0.035em] text-slate-800">
        Understand deeply.<br />Build thoughtfully.
      </p>

      <div class="mt-7 flex min-h-12 items-center gap-2 font-mono text-sm font-medium text-blue-700 sm:text-base">
        <span class="text-slate-400">&gt;</span>
        <span id="typewriter" data-identities={JSON.stringify(identities)}>{identities[0]}</span>
        <span class="typewriter-cursor shrink-0" aria-hidden="true"></span>
      </div>

      <p class="mt-6 max-w-xl text-base leading-7 text-slate-600 sm:text-lg sm:leading-8">
        I'm an undergraduate in Information and Computational Science at Hefei University of Technology.
        My interests span mathematics, machine learning, and software engineering.
      </p>

      <dl class="mt-12 grid max-w-xl grid-cols-2 gap-6 border-t border-slate-300/80 pt-6 text-sm sm:grid-cols-3">
        <div>
          <dt class="text-xs uppercase tracking-widest text-slate-500">Based at</dt>
          <dd class="mt-1 font-semibold text-slate-800">HFUT, China</dd>
        </div>
        <div>
          <dt class="text-xs uppercase tracking-widest text-slate-500">Research</dt>
          <dd class="mt-1 font-semibold text-slate-800">Machine Learning</dd>
        </div>
        <div class="col-span-2 sm:col-span-1">
          <dt class="text-xs uppercase tracking-widest text-slate-500">Engineering</dt>
          <dd class="mt-1 font-semibold text-slate-800">Software</dd>
        </div>
      </dl>
    </div>

    <div class="relative mx-auto w-full max-w-[34rem] lg:mr-0" aria-hidden="true">
      <div class="visual-frame relative aspect-square">
        <div class="board absolute inset-[10%] overflow-hidden rounded-[2rem] border border-slate-300/80 bg-white/70 shadow-[0_35px_100px_-45px_rgba(15,23,42,0.45)] backdrop-blur-sm">
          <svg class="h-full w-full" viewBox="0 0 500 500" fill="none" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="curve" x1="70" y1="420" x2="440" y2="80" gradientUnits="userSpaceOnUse">
                <stop stop-color="#2563eb" stop-opacity="0.15"></stop>
                <stop offset="0.5" stop-color="#2563eb"></stop>
                <stop offset="1" stop-color="#0f172a"></stop>
              </linearGradient>
              <radialGradient id="stone" cx="0" cy="0" r="1" gradientTransform="translate(0.3 0.25) scale(0.8)">
                <stop stop-color="#475569"></stop>
                <stop offset="1" stop-color="#020617"></stop>
              </radialGradient>
              <pattern id="go-grid" width="25" height="25" patternUnits="userSpaceOnUse">
                <path d="M25 0H0V25" stroke="#64748b" stroke-opacity="0.18" stroke-width="1"></path>
              </pattern>
            </defs>

            <rect width="500" height="500" fill="url(#go-grid)"></rect>
            <path class="data-curve" d="M22 392C92 407 100 285 177 304C251 322 252 211 315 221C373 230 387 124 477 76" stroke="url(#curve)" stroke-width="4" stroke-linecap="round"></path>
            <path d="M22 409C97 428 113 318 184 335C255 352 276 275 342 281C400 286 422 211 477 192" stroke="#2563eb" stroke-opacity="0.18" stroke-width="2" stroke-dasharray="6 10"></path>

            <g stroke="#2563eb" stroke-opacity="0.32">
              <path d="M99 112L174 168L247 98L324 151L400 101"></path>
              <path d="M99 112L143 225L247 98L270 188L400 101"></path>
              <path d="M174 168L270 188L324 151"></path>
            </g>
            <g fill="#fff" stroke="#2563eb" stroke-width="3">
              <circle cx="99" cy="112" r="8"></circle>
              <circle cx="174" cy="168" r="7"></circle>
              <circle cx="247" cy="98" r="10"></circle>
              <circle cx="270" cy="188" r="7"></circle>
              <circle cx="324" cy="151" r="8"></circle>
              <circle cx="400" cy="101" r="7"></circle>
              <circle cx="143" cy="225" r="6"></circle>
            </g>

            <g class="go-stone">
              <circle cx="175" cy="350" r="17" fill="url(#stone)"></circle>
              <ellipse cx="175" cy="372" rx="20" ry="6" fill="#0f172a" fill-opacity="0.13"></ellipse>
            </g>
            <g class="go-stone go-stone-delay">
              <circle cx="350" cy="325" r="17" fill="#fff" stroke="#cbd5e1" stroke-width="2"></circle>
              <ellipse cx="350" cy="347" rx="20" ry="6" fill="#0f172a" fill-opacity="0.1"></ellipse>
            </g>
          </svg>

          <div class="absolute bottom-6 left-6 font-mono text-[0.65rem] uppercase leading-5 tracking-[0.18em] text-slate-500">
            Patterns become models<br />Models become insight
          </div>
          <div class="absolute bottom-6 right-6 text-right font-mono text-xs font-semibold text-blue-700">
            19 x 19<br />f(x) -&gt; y
          </div>
        </div>

        <div class="orbit-label orbit-math absolute left-0 top-[19%]">MATHEMATICS</div>
        <div class="orbit-label orbit-ai absolute right-0 top-[34%]">DEEP LEARNING</div>
        <div class="orbit-label orbit-go absolute bottom-[16%] right-[5%]">SOFTWARE</div>

        <div class="absolute right-[8%] top-[5%] grid h-16 w-16 place-items-center rounded-full bg-blue-600 font-serif text-3xl italic leading-none text-white shadow-xl shadow-blue-600/20">
          Σ
        </div>
        <div class="absolute bottom-[6%] left-[6%] grid h-12 w-12 place-items-center rounded-full border border-slate-300 bg-white font-serif text-lg italic text-slate-800 shadow-lg">
          ∂
        </div>
      </div>
    </div>
  </div>

  <a href="/#research" class="absolute bottom-5 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-2 text-[0.65rem] font-semibold uppercase tracking-[0.24em] text-slate-500 transition hover:text-blue-600 lg:flex" aria-label="Scroll to research">
    Scroll
    <span class="h-8 w-px bg-gradient-to-b from-slate-400 to-transparent"></span>
  </a>
</section>

<script>
  const initTypewriter = () => {
    const el = document.getElementById("typewriter");
    if (!el || el.dataset.bound) return;
    el.dataset.bound = "true";

    const identities: string[] = JSON.parse(el.dataset.identities ?? "[]");
    if (identities.length === 0) return;

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      el.textContent = identities[0] ?? "";
      return;
    }

    let identityIndex = 0;
    let charIndex = 0;
    let deleting = false;

    const tick = () => {
      if (!el.isConnected) return;

      const current = identities[identityIndex]!;
      charIndex += deleting ? -1 : 1;
      el.textContent = current.slice(0, charIndex);

      let delay = deleting ? 35 : 65;
      if (!deleting && charIndex === current.length) {
        delay = 1900;
        deleting = true;
      } else if (deleting && charIndex === 0) {
        delay = 300;
        deleting = false;
        identityIndex = (identityIndex + 1) % identities.length;
      }
      window.setTimeout(tick, delay);
    };

    tick();
  };

  initTypewriter();
  document.addEventListener("astro:page-load", initTypewriter);
</script>

<style>
  .hero-shell {
    background:
      radial-gradient(circle at 10% 20%, rgb(219 234 254 / 0.7), transparent 28rem),
      linear-gradient(135deg, #f8fafc 0%, #ffffff 50%, #f1f5f9 100%);
  }

  .hero-grid {
    background-image:
      linear-gradient(rgb(15 23 42 / 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgb(15 23 42 / 0.035) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(to right, black, transparent 70%);
  }

  .hero-glow {
    right: -12rem;
    top: 12%;
    width: 42rem;
    height: 42rem;
    border-radius: 9999px;
    background: rgb(37 99 235 / 0.1);
    filter: blur(90px);
  }

  .visual-frame::before,
  .visual-frame::after {
    position: absolute;
    content: "";
    border-radius: 9999px;
    border: 1px solid rgb(100 116 139 / 0.2);
  }

  .visual-frame::before {
    inset: 2%;
  }

  .visual-frame::after {
    inset: 17%;
    border-style: dashed;
  }

  .board {
    transform: rotate(3deg);
    animation: board-float 8s ease-in-out infinite;
  }

  .orbit-label {
    z-index: 10;
    border: 1px solid rgb(203 213 225 / 0.9);
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.9);
    padding: 0.55rem 0.8rem;
    box-shadow: 0 12px 30px -18px rgb(15 23 42 / 0.6);
    color: #334155;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.13em;
  }

  .orbit-math {
    animation: label-float 5s ease-in-out infinite;
  }

  .orbit-ai {
    animation: label-float 5s 1.4s ease-in-out infinite;
  }

  .orbit-go {
    animation: label-float 5s 2.8s ease-in-out infinite;
  }

  .data-curve {
    stroke-dasharray: 12 8;
    animation: data-flow 4s linear infinite;
  }

  .go-stone {
    transform-origin: 175px 350px;
    animation: stone-pulse 4s ease-in-out infinite;
  }

  .go-stone-delay {
    transform-origin: 350px 325px;
    animation-delay: 2s;
  }

  .typewriter-cursor {
    width: 0.5rem;
    height: 1.1rem;
    background: #2563eb;
    animation: blink 1s step-end infinite;
  }

  @keyframes board-float {
    0%, 100% { transform: rotate(3deg) translateY(0); }
    50% { transform: rotate(1.5deg) translateY(-10px); }
  }

  @keyframes label-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-7px); }
  }

  @keyframes data-flow {
    to { stroke-dashoffset: -40; }
  }

  @keyframes stone-pulse {
    0%, 75%, 100% { transform: scale(1); }
    82% { transform: scale(1.12); }
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  @media (max-width: 1023px) {
    .hero-grid {
      mask-image: linear-gradient(to bottom, black, transparent 70%);
    }

    .visual-frame {
      margin-top: -1rem;
    }
  }

  @media (max-width: 480px) {
    .orbit-label {
      padding: 0.45rem 0.65rem;
      font-size: 0.55rem;
    }

    .board {
      inset: 8%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .board,
    .orbit-label,
    .data-curve,
    .go-stone,
    .typewriter-cursor {
      animation: none;
    }
  }
</style>
