---
import { books } from "../../lib/books";
---

<section id="books" class="border-y border-slate-200 bg-slate-100/70" aria-labelledby="books-heading">
  <div class="mx-auto max-w-7xl px-6 py-20 sm:px-8 sm:py-24">
    <header class="mb-10 grid items-end gap-6 lg:grid-cols-[1fr_0.65fr] lg:gap-16">
      <div>
        <div class="mb-4 flex items-center gap-3 font-mono text-[0.65rem] font-bold uppercase tracking-[0.24em] text-blue-600">
          <span>05</span>
          <span class="h-px w-10 bg-blue-600"></span>
          Bookshelf
        </div>
        <h2 id="books-heading" class="text-4xl font-black leading-[0.98] tracking-[-0.045em] text-slate-950 sm:text-5xl lg:text-6xl">
          Books.
        </h2>
      </div>
      <p class="max-w-xl text-base leading-7 text-slate-600 lg:pb-1 lg:text-lg lg:leading-8">
        A few books that have shaped the way I think.
      </p>
    </header>

    <ul class="flex gap-6 overflow-x-auto px-3 pb-6 pt-6 sm:gap-8 lg:justify-between" role="list" tabindex="0" aria-label="Bookshelf">
      {books.map((book) => (
        <li class="book-item w-36 shrink-0 sm:w-44 lg:w-52">
          <figure id={`book-${book.id}`} class="scroll-mt-20">
            <div class="book-stage" style={`--book-ratio: ${book.cover.width / book.cover.height}`}>
              <div class="book-model">
                <span class="book-back" aria-hidden="true"></span>
                <div class="book-cover">
                  <img
                    {...book.cover}
                    alt={`${book.title} book cover`}
                    loading="lazy"
                    decoding="async"
                    class="block h-full w-full object-cover"
                  />
                </div>
              </div>
            </div>
            <figcaption class="mt-6 text-center text-sm font-semibold leading-6 text-slate-800 sm:text-base">{book.name}</figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .book-stage {
    --book-height: 14rem;
    --book-depth: 10px;
    position: relative;
    display: flex;
    height: var(--book-height);
    align-items: flex-end;
    justify-content: center;
    perspective: 900px;
    perspective-origin: 50% 40%;
  }

  .book-stage::before {
    position: absolute;
    right: 8%;
    bottom: -9px;
    left: 12%;
    height: 15px;
    border-radius: 50%;
    background: rgb(15 23 42 / 0.2);
    filter: blur(8px);
    pointer-events: none;
    content: "";
    transition: transform 420ms ease, opacity 420ms ease;
  }

  .book-model {
    position: relative;
    width: min(calc(100% - 0.75rem), calc(var(--book-height) * var(--book-ratio)));
    aspect-ratio: var(--book-ratio);
    transform-style: preserve-3d;
    transform: rotateX(2deg) rotateY(-10deg);
    transition: transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .book-back {
    position: absolute;
    inset: 0;
    border-radius: 2px 4px 4px 2px;
    background: #334155;
    box-shadow: 5px 7px 16px rgb(15 23 42 / 0.18);
    transform: translateZ(calc(-1 * var(--book-depth)));
  }

  .book-model::before,
  .book-model::after {
    position: absolute;
    backface-visibility: hidden;
    content: "";
  }

  .book-model::before {
    top: 3px;
    bottom: 3px;
    left: 100%;
    width: var(--book-depth);
    background: repeating-linear-gradient(to right, #d8d5ce 0 1px, #faf8f2 1px 3px);
    transform-origin: left center;
    transform: rotateY(90deg);
  }

  .book-model::after {
    top: 100%;
    right: 2px;
    left: 2px;
    height: var(--book-depth);
    background: repeating-linear-gradient(to bottom, #d8d5ce 0 1px, #f3f0e8 1px 3px);
    transform-origin: center top;
    transform: rotateX(-90deg);
  }

  .book-cover {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 2px 4px 4px 2px;
    background: #fff;
    transform: translateZ(0.5px);
  }

  .book-cover::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(0 0 0 / 0.3), rgb(0 0 0 / 0.12) 2%, rgb(255 255 255 / 0.28) 3.5%, rgb(0 0 0 / 0.14) 5%, transparent 9%, transparent 95%, rgb(0 0 0 / 0.1));
    box-shadow: inset 0 0 0 1px rgb(15 23 42 / 0.1);
    pointer-events: none;
    content: "";
  }

  @media (min-width: 640px) {
    .book-stage {
      --book-height: 16rem;
    }
  }

  @media (min-width: 1024px) {
    .book-stage {
      --book-height: 18rem;
    }
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .book-item:hover .book-model {
      transform: translateY(-8px) rotateX(4deg) rotateY(-16deg) rotateZ(-1deg);
    }

    .book-item:hover .book-stage::before {
      opacity: 0.6;
      transform: translateY(3px) scale(0.92);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-model,
    .book-stage::before {
      transition: none;
    }
  }
</style>
