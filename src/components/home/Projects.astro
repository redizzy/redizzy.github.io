---
const technologies = ["Python", "PyTorch", "Audio-Visual Learning", "Deep Learning"];

const reservedProjects = [
  {
    index: "02",
    title: "Demo Project 02",
    eyebrow: "Next build",
    desc: "Reserved for the next project that is ready to document and share.",
    variant: "blueprint-a",
  },
  {
    index: "03",
    title: "Demo Project 03",
    eyebrow: "Open slot",
    desc: "A future home for another research, data, or software experiment.",
    variant: "blueprint-b",
  },
  {
    index: "04",
    title: "Demo Project 04",
    eyebrow: "Future idea",
    desc: "This space will grow when the next idea becomes a complete build.",
    variant: "blueprint-c",
  },
];
---

<section id="projects" class="projects-section relative overflow-hidden bg-white">
  <div class="project-glow pointer-events-none absolute right-[-12rem] top-16 h-[32rem] w-[32rem] rounded-full bg-blue-100/70 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:py-32">
    <div class="mb-12 grid items-end gap-6 lg:grid-cols-[1fr_0.65fr] lg:gap-16">
      <div>
        <div class="mb-4 flex items-center gap-3 font-mono text-[0.65rem] font-bold uppercase tracking-[0.24em] text-blue-600">
          <span>02</span>
          <span class="h-px w-10 bg-blue-600"></span>
          Selected work
        </div>
        <h2 class="max-w-4xl text-4xl font-black leading-[0.98] tracking-[-0.045em] text-slate-950 sm:text-5xl lg:text-6xl">
          One project today.<br />Room for what comes next.
        </h2>
      </div>
      <p class="max-w-xl text-base leading-7 text-slate-600 lg:pb-1 lg:text-lg lg:leading-8">
        A growing index of research and software work. Each slot is designed to become a complete
        project story rather than a disconnected thumbnail.
      </p>
    </div>

    <div class="project-index grid gap-4 lg:grid-cols-12">
      <article class="featured-project overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-50 shadow-[0_35px_100px_-55px_rgba(15,23,42,0.4)] lg:col-span-8">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-6 py-4 sm:px-8">
          <div class="flex items-center gap-3">
            <span class="relative flex h-2.5 w-2.5">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-500 opacity-40 motion-reduce:animate-none"></span>
              <span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-blue-600"></span>
            </span>
            <span class="font-mono text-[0.65rem] font-bold uppercase tracking-[0.2em] text-slate-500">Published / Featured</span>
          </div>
          <span class="font-mono text-[0.6rem] uppercase tracking-[0.18em] text-slate-400">Project 001</span>
        </div>

        <div class="p-7 sm:p-9 lg:p-10">
          <div class="max-w-3xl">
            <div class="mb-5 flex items-center gap-2">
              <span class="rounded-full bg-slate-950 px-3 py-1 font-mono text-[0.6rem] font-bold uppercase tracking-wider text-white">GAANet</span>
              <span class="rounded-full border border-slate-200 bg-white px-3 py-1 font-mono text-[0.6rem] font-bold uppercase tracking-wider text-slate-500">Research code</span>
            </div>
            <h3 class="text-3xl font-black leading-[1.05] tracking-[-0.04em] text-slate-950 sm:text-4xl">
              Global-guided Asymmetric Attention Network
            </h3>
            <p class="mt-3 font-mono text-[0.65rem] font-bold uppercase tracking-[0.13em] text-blue-600">
              Audio-Visual Speech Separation
            </p>
          </div>

          <div class="mt-5 flex flex-wrap items-center justify-between gap-4">
            <div class="flex flex-wrap gap-2">
              {technologies.map((technology) => <span class="tech-tag">{technology}</span>)}
            </div>
            <div class="flex flex-wrap gap-2">
              <a
                href="https://github.com/redizzy/GAANet"
                target="_blank"
                rel="noopener noreferrer"
                class="project-button group inline-flex h-9 items-center gap-2 rounded-lg bg-blue-600 px-4 text-xs font-bold text-white transition hover:bg-blue-700"
              >
                GitHub
                <svg class="h-3.5 w-3.5 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M7 17L17 7M8 7h9v9"></path>
                </svg>
              </a>
              <button
                type="button"
                disabled
                title="Google Scholar link coming soon"
                class="inline-flex h-9 cursor-not-allowed items-center rounded-lg border border-slate-300 bg-white px-4 text-xs font-bold text-slate-400"
              >
                Google Scholar
              </button>
            </div>
          </div>
        </div>

        <div class="architecture-wrap relative mx-4 mb-4 overflow-hidden rounded-2xl border border-slate-300/80 bg-slate-200/70 p-3 sm:mx-6 sm:mb-6 sm:p-5">
          <div class="architecture-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
          <figure class="relative overflow-hidden rounded-xl border border-slate-200 bg-white shadow-[0_20px_45px_-35px_rgba(15,23,42,0.35)]">
            <figcaption class="flex items-center justify-between border-b border-slate-200 bg-slate-50 px-4 py-3">
              <span class="font-mono text-[0.58rem] font-bold uppercase tracking-[0.16em] text-slate-500">A-V Fusion Block / D = 3</span>
              <span class="font-mono text-[0.55rem] uppercase tracking-wider text-slate-400">Architecture</span>
            </figcaption>
            <div class="group flex min-h-44 items-center p-3 sm:p-4">
              <img
                src="/proj1_img.webp"
                width="2000"
                height="901"
                loading="lazy"
                decoding="async"
                alt="GAANet audio-visual fusion architecture showing audio and video multi-scale feature flows"
                class="w-full transition-transform duration-500 group-hover:scale-[1.02] motion-reduce:transition-none"
              />
            </div>
          </figure>
        </div>

      </article>

      <div class="grid gap-4 sm:grid-cols-3 lg:col-span-4 lg:grid-cols-1">
        {
          reservedProjects.map(({ index, title, eyebrow, desc, variant }) => (
            <article class:list={["reserved-project group relative min-h-52 overflow-hidden rounded-[2rem] border border-dashed border-slate-300 bg-slate-50 p-6 sm:min-h-64 sm:p-7 lg:min-h-0", variant]}>
              <div class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
              <div class="blueprint-shape pointer-events-none absolute right-5 top-5 h-20 w-20" aria-hidden="true">
                <span class="absolute inset-0 rounded-full border border-blue-300/60"></span>
                <span class="absolute inset-[24%] rotate-45 border border-slate-300"></span>
                <span class="absolute left-1/2 top-0 h-full w-px bg-slate-200"></span>
                <span class="absolute left-0 top-1/2 h-px w-full bg-slate-200"></span>
              </div>

              <div class="relative flex h-full flex-col">
                <div class="flex items-center justify-between gap-3">
                  <span class="rounded-full border border-slate-300 bg-white/80 px-2.5 py-1 font-mono text-[0.55rem] font-bold uppercase tracking-[0.14em] text-slate-500">Reserved</span>
                  <span class="font-mono text-[0.6rem] font-bold text-slate-300">{index}</span>
                </div>
                <div class="mt-auto pt-16">
                  <span class="font-mono text-[0.56rem] font-bold uppercase tracking-[0.17em] text-blue-600">{eyebrow}</span>
                  <h3 class="mt-2 text-xl font-extrabold tracking-tight text-slate-800">{title}</h3>
                  <p class="mt-2 text-xs leading-5 text-slate-500 sm:text-sm sm:leading-6">{desc}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    <div class="mt-8 flex flex-col items-start justify-between gap-5 border-t border-slate-200 pt-7 sm:flex-row sm:items-center">
      <div class="flex items-center gap-5 font-mono text-[0.6rem] font-bold uppercase tracking-[0.15em]">
        <span class="text-blue-600">01 published</span>
        <span class="h-1 w-1 rounded-full bg-slate-300"></span>
        <span class="text-slate-400">03 reserved</span>
      </div>
      <a href="/projects" class="group inline-flex items-center gap-2 text-sm font-extrabold text-slate-800 transition hover:text-blue-600">
        View all projects
        <span class="transition-transform group-hover:translate-x-1">-&gt;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .architecture-grid,
  .blueprint-grid {
    background-image:
      linear-gradient(rgb(71 85 105 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(71 85 105 / 0.07) 1px, transparent 1px);
    background-size: 32px 32px;
  }

  .blueprint-grid {
    background-size: 24px 24px;
    opacity: 0.42;
    mask-image: linear-gradient(135deg, black, transparent 72%);
  }

  .tech-tag {
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.75);
    padding: 0.42rem 0.68rem;
    color: #475569;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.625rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .reserved-project {
    transition: border-color 250ms ease, background-color 250ms ease, transform 250ms ease;
  }

  .reserved-project:hover {
    border-color: #93c5fd;
    background: #f8fbff;
    transform: translateX(-3px);
  }

  .blueprint-shape {
    transition: opacity 250ms ease, transform 400ms ease;
  }

  .reserved-project:hover .blueprint-shape {
    opacity: 0.85;
    transform: rotate(8deg);
  }

  .blueprint-b .blueprint-shape {
    transform: rotate(30deg) scale(0.85);
  }

  .blueprint-b:hover .blueprint-shape {
    transform: rotate(38deg) scale(0.85);
  }

  .blueprint-c .blueprint-shape {
    transform: rotate(-20deg) scale(0.72);
  }

  .blueprint-c:hover .blueprint-shape {
    transform: rotate(-12deg) scale(0.72);
  }

  @media (prefers-reduced-motion: reduce) {
    .reserved-project,
    .blueprint-shape {
      transition: none;
    }

    .reserved-project:hover {
      transform: none;
    }
  }
</style>
