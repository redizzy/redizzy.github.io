---
import type { projectGroups } from "../../lib/projects";

interface Props {
  group: (typeof projectGroups)[number];
  index: string;
}

const { group, index } = Astro.props;

const reservedProjects = [
  {
    group: "research",
    title: "Demo Project 02",
    eyebrow: "Next build",
    desc: "Reserved for a future research project, with its methods, experiments, and code.",
    variant: "blueprint-a",
  },
].filter((project) => project.group === group.id);
---

<section id={group.id} class:list={["projects-section relative overflow-hidden", group.id === "research" ? "bg-white" : "border-y border-slate-200 bg-slate-50"]} aria-labelledby={`${group.id}-heading`}>
  <div class="project-glow pointer-events-none absolute right-[-12rem] top-16 h-[32rem] w-[32rem] rounded-full bg-blue-100/70 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-6 py-24 sm:px-8 sm:py-28 lg:py-32">
    <div class="mb-12 grid items-end gap-6 lg:grid-cols-[1fr_0.65fr] lg:gap-16">
      <div>
        <div class="mb-4 flex items-center gap-3 font-mono text-[0.65rem] font-bold uppercase tracking-[0.24em] text-blue-600">
          <span>{index}</span>
          <span class="h-px w-10 bg-blue-600"></span>
          {group.id === "research" ? "Machine learning & experiments" : "Applications & engineering"}
        </div>
        <h2 id={`${group.id}-heading`} class="max-w-4xl text-4xl font-black leading-[0.98] tracking-[-0.045em] text-slate-950 sm:text-5xl lg:text-6xl">
          {group.title}.
        </h2>
      </div>
      <p class="max-w-xl text-base leading-7 text-slate-600 [text-wrap:balance] lg:pb-1 lg:text-lg lg:leading-8">
        {group.description}
      </p>
    </div>

    <div class="project-index grid gap-5">
      {group.projects.map((project) => (
        <article class="featured-project min-w-0 overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_35px_100px_-55px_rgba(15,23,42,0.4)]">
          <header class="flex flex-wrap items-center justify-between gap-3 border-b border-slate-200 px-6 py-4 sm:px-8">
            <span class="font-mono text-xs font-bold uppercase tracking-[0.12em] text-slate-600">{project.category}</span>
            <span class="rounded-full border border-blue-200 bg-blue-50 px-3 py-1 text-xs font-bold text-blue-700">{project.status}</span>
          </header>

          <div class="grid gap-8 p-7 sm:p-9 lg:grid-cols-2 lg:items-center lg:gap-12">
            <div class="min-w-0">
              <div class:list={[group.id === "software" && "flex items-center gap-4 sm:gap-5"]}>
                {group.id === "software" && (
                  <div class="grid h-16 w-16 shrink-0 place-items-center overflow-hidden rounded-2xl bg-slate-100 ring-1 ring-inset ring-slate-200 sm:h-24 sm:w-24 sm:rounded-3xl">
                    {project.icon ? (
                      <img src={project.icon} alt={`${project.name} app icon`} width="96" height="96" loading="lazy" decoding="async" class="h-full w-full object-contain" />
                    ) : (
                      <span class="text-3xl font-black text-slate-400 sm:text-4xl" aria-hidden="true">{project.name.charAt(0)}</span>
                    )}
                  </div>
                )}
                <div class="min-w-0">
                  <h3 class:list={["font-black tracking-[-0.04em] text-slate-950 sm:text-5xl", group.id === "software" ? "text-3xl" : "text-4xl"]}>{project.name}</h3>
                  <p class:list={[group.id === "software" ? "mt-2 text-xs font-normal leading-5 text-slate-500 sm:text-sm sm:leading-6" : "mt-3 text-sm font-bold text-blue-700"]}>{project.subtitle}</p>
                </div>
              </div>
              {project.title !== project.name && <p class="mt-4 text-base font-semibold leading-6 text-slate-800">{project.title}</p>}
              <p class="mt-4 text-sm leading-7 text-slate-600">{project.description}</p>
              <div class="mt-5 flex flex-wrap gap-2">
                {project.tags.map((tag) => <span class="tech-tag">{tag}</span>)}
              </div>

              <footer class="mt-8 flex flex-col items-start gap-4 border-t border-slate-200 pt-6">
                <p class="text-sm leading-6 text-slate-600">{project.note}</p>
                <div class="flex flex-wrap gap-3">
                  {project.links.map((link) => (
                    <a href={link.href} target="_blank" rel="noopener noreferrer" class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-blue-600 px-5 py-2 text-sm font-bold text-white transition hover:bg-blue-700" aria-label={`${project.name} — ${link.label}`}>
                      {link.label}
                      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9" /></svg>
                    </a>
                  ))}
                </div>
              </footer>
            </div>

            <div class="relative min-w-0 overflow-hidden rounded-2xl border border-slate-200 bg-white">
              {project.image && (
                <figure class="flex min-h-64 flex-col">
                  <figcaption class="border-b border-slate-200 bg-slate-100 px-4 py-3 font-mono text-xs font-bold text-slate-600">{project.name} / Architecture</figcaption>
                  <a href={project.image.src} target="_blank" rel="noopener noreferrer" class="flex flex-1 items-center p-4" aria-label={`View ${project.name} image at full size`}>
                    <img {...project.image} loading="lazy" decoding="async" class="h-auto w-full" />
                  </a>
                </figure>
              )}
              {project.features && (
                <div class="min-h-64">
                  <div class="border-b border-slate-200 bg-blue-50 px-4 py-3 font-mono text-xs font-bold text-blue-700">Inside {project.name}</div>
                  <ul class="divide-y divide-slate-100 px-5">
                    {project.features.map((feature, index) => (
                      <li class="flex items-start gap-4 py-4 text-sm font-medium leading-6 text-slate-700">
                        <span class="font-mono text-xs leading-6 text-blue-600" aria-hidden="true">{(index + 1).toString().padStart(2, "0")}</span>
                        {feature}
                      </li>
                    ))}
                  </ul>
                </div>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>

    {reservedProjects.length > 0 && (
      <div class:list={["mt-5 grid gap-4", reservedProjects.length > 1 && "md:grid-cols-2"]}>
        {
          reservedProjects.map(({ title, eyebrow, desc, variant }) => (
            <article class:list={["reserved-project group relative overflow-hidden rounded-[2rem] border border-dashed border-slate-300 bg-slate-50 p-6 sm:p-7", variant]}>
              <div class="blueprint-grid pointer-events-none absolute inset-0" aria-hidden="true"></div>
              <div class="blueprint-shape pointer-events-none absolute right-5 top-5 h-20 w-20" aria-hidden="true">
                <span class="absolute inset-0 rounded-full border border-blue-300/60"></span>
                <span class="absolute inset-[24%] rotate-45 border border-slate-300"></span>
                <span class="absolute left-1/2 top-0 h-full w-px bg-slate-200"></span>
                <span class="absolute left-0 top-1/2 h-px w-full bg-slate-200"></span>
              </div>

              <div class="relative flex h-full flex-col">
                <span class="w-fit rounded-full border border-slate-300 bg-white/80 px-2.5 py-1 font-mono text-[0.55rem] font-bold uppercase tracking-[0.14em] text-slate-500">Reserved</span>
                <div class="mt-auto pt-8">
                  <span class="font-mono text-[0.56rem] font-bold uppercase tracking-[0.17em] text-blue-600">{eyebrow}</span>
                  <h3 class="mt-2 text-xl font-extrabold tracking-tight text-slate-800">{title}</h3>
                  <p class="mt-2 text-xs leading-5 text-slate-500 sm:text-sm sm:leading-6">{desc}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    )}

    <div class="mt-8 flex flex-col items-start justify-between gap-5 border-t border-slate-200 pt-7 sm:flex-row sm:items-center">
      <div class="flex items-center gap-5 font-mono text-[0.6rem] font-bold uppercase tracking-[0.15em]">
        <span class="text-blue-600">{group.projects.length.toString().padStart(2, "0")} featured</span>
        {reservedProjects.length > 0 && (
          <>
            <span class="h-1 w-1 rounded-full bg-slate-300"></span>
            <span class="text-slate-500">{reservedProjects.length.toString().padStart(2, "0")} reserved</span>
          </>
        )}
      </div>
      <a href={`/projects#${group.archiveId}`} class="group inline-flex items-center gap-2 text-sm font-extrabold text-slate-800 transition hover:text-blue-600">
        View {group.title.toLowerCase()} projects
        <span class="transition-transform group-hover:translate-x-1">-&gt;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .blueprint-grid {
    background-image:
      linear-gradient(rgb(71 85 105 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(71 85 105 / 0.07) 1px, transparent 1px);
    background-size: 24px 24px;
    opacity: 0.42;
    mask-image: linear-gradient(135deg, black, transparent 72%);
  }

  .tech-tag {
    border: 1px solid #cbd5e1;
    border-radius: 9999px;
    background: rgb(255 255 255 / 0.75);
    padding: 0.42rem 0.68rem;
    color: #475569;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }

  .reserved-project {
    transition: border-color 250ms ease, background-color 250ms ease, transform 250ms ease;
  }

  .reserved-project:hover {
    border-color: #93c5fd;
    background: #f8fbff;
    transform: translateX(-3px);
  }

  .blueprint-shape {
    transition: opacity 250ms ease, transform 400ms ease;
  }

  .reserved-project:hover .blueprint-shape {
    opacity: 0.85;
    transform: rotate(8deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .reserved-project,
    .blueprint-shape {
      transition: none;
    }

    .reserved-project:hover {
      transform: none;
    }
  }
</style>
