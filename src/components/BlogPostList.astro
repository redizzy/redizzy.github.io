---
import type { CollectionEntry } from "astro:content";
import createSlug from "../lib/createSlug";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;
const formatDate = (date: Date) =>
  new Intl.DateTimeFormat("en", {
    year: "numeric",
    month: "short",
    day: "2-digit",
  }).format(date);
---

{
  posts.length > 0 ? (
    <ol class="divide-y divide-slate-200 border-y border-slate-200">
      {posts.map((post, index) => (
        <li>
          <a
            href={`/blog/${createSlug(post.data.title, post.slug)}`}
            class="post-row group grid gap-5 py-8 transition sm:grid-cols-[7rem_1fr_auto] sm:items-start sm:py-10"
          >
            <div>
              <span class="font-mono text-[0.58rem] font-black uppercase tracking-[0.18em] text-blue-600">
                Entry {(index + 1).toString().padStart(2, "0")}
              </span>
              <time datetime={post.data.pubDate.toISOString()} class="mt-2 block text-xs text-slate-400">
                {formatDate(post.data.pubDate)}
              </time>
            </div>

            <div>
              <div class="flex flex-wrap items-center gap-3">
                <h2 class="text-xl font-extrabold leading-tight tracking-[-0.025em] text-slate-950 transition-colors group-hover:text-blue-700 sm:text-2xl">
                  {post.data.title}
                </h2>
                {post.data.badge && (
                  <span class="rounded-full border border-blue-200 bg-blue-50 px-2.5 py-1 font-mono text-[0.52rem] font-bold uppercase tracking-[0.12em] text-blue-600">
                    {post.data.badge}
                  </span>
                )}
              </div>
              <p class="mt-3 max-w-3xl text-sm leading-6 text-slate-500">{post.data.description}</p>
              <div class="mt-4 flex flex-wrap gap-2">
                {(post.data.tags ?? ["Journal"]).map((tag) => (
                  <span class="rounded-full border border-slate-200 bg-slate-50 px-2.5 py-1 font-mono text-[0.55rem] font-bold uppercase tracking-[0.08em] text-slate-500">
                    {tag}
                  </span>
                ))}
              </div>
            </div>

            <span class="grid h-9 w-9 place-items-center rounded-full border border-slate-200 text-slate-400 transition group-hover:border-blue-300 group-hover:bg-blue-50 group-hover:text-blue-600 sm:mt-1">
              -&gt;
            </span>
          </a>
        </li>
      ))}
    </ol>
  ) : (
    <div class="border-y border-dashed border-slate-300 py-16 text-center">
      <div class="font-mono text-[0.58rem] font-bold uppercase tracking-[0.18em] text-slate-400">Notebook empty</div>
      <p class="mt-3 text-base font-bold text-slate-700">The first article is still in progress.</p>
    </div>
  )
}
