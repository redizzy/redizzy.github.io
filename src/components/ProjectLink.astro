---
import type { Project } from "../lib/projects";

interface Props {
  link: Project["links"][number];
  projectName: string;
  compact?: boolean;
}

const { link: { href, label }, projectName, compact = false } = Astro.props;
const isGitHub = label === "GitHub";
const isAppStore = label === "App Store";
const isGooglePlay = label === "Google Play";
const isStore = isAppStore || isGooglePlay;

// Apple mark: Bootstrap Icons. Google Play mark: SVG Logos.
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${projectName} — ${label}`}
  title={isGitHub ? `View ${projectName} on GitHub` : undefined}
  class:list={[
    "project-link",
    {
      "project-link--github": isGitHub,
      "project-link--store": isStore,
      "project-link--website": !isGitHub && !isStore,
      "project-link--compact": compact,
    },
  ]}
>
  {isGitHub ? (
    <>
      <svg class="github-icon" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.523 2 12 2z" />
      </svg>
      <span>{label}</span>
    </>
  ) : isStore ? (
    <>
      {isAppStore ? (
        <svg class="store-icon" width={compact ? 18 : 24} height={compact ? 18 : 24} viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" focusable="false">
          <path d="M11.182.008C11.148-.03 9.923.023 8.857 1.18c-1.066 1.156-.902 2.482-.878 2.516s1.52.087 2.475-1.258.762-2.391.728-2.43m3.314 11.733c-.048-.096-2.325-1.234-2.113-3.422s1.675-2.789 1.698-2.854-.597-.79-1.254-1.157a3.7 3.7 0 0 0-1.563-.434c-.108-.003-.483-.095-1.254.116-.508.139-1.653.589-1.968.607-.316.018-1.256-.522-2.267-.665-.647-.125-1.333.131-1.824.328-.49.196-1.422.754-2.074 2.237-.652 1.482-.311 3.83-.067 4.56s.625 1.924 1.273 2.796c.576.984 1.34 1.667 1.659 1.899s1.219.386 1.843.067c.502-.308 1.408-.485 1.766-.472.357.013 1.061.154 1.782.539.571.197 1.111.115 1.652-.105.541-.221 1.324-1.059 2.238-2.758q.52-1.185.473-1.282" />
        </svg>
      ) : (
        <svg class="store-icon" width={compact ? 18 : 24} height={compact ? 18 : 24} viewBox="0 0 256 283" aria-hidden="true" focusable="false">
          <path d="M119.553141,134.916362 L1.0599006,259.060547 C3.75619448,268.616998 10.7182836,276.3906 19.9208658,280.119977 C29.1234481,283.849353 39.5331235,283.115716 48.121672,278.132484 L181.448642,202.197919 L119.553141,134.916362 Z" fill="#EA4335" />
          <path d="M239.370822,113.813616 L181.71353,80.7909097 L116.815965,137.741834 L181.978418,202.021326 L239.19423,169.351804 C249.525723,163.942452 256,153.24465 256,141.58271 C256,129.92077 249.525723,119.222968 239.19423,113.813616 L239.370822,113.813616 Z" fill="#FBBC04" />
          <path d="M1.0599006,23.4868015 C0.343633396,26.134699 -0.0127538816,28.8670014 0,31.6100341 L0,250.937314 C0.00751268399,253.679042 0.363556675,256.408712 1.0599006,259.060547 L123.614758,138.095018 L1.0599006,23.4868015 Z" fill="#4285F4" />
          <path d="M120.436101,141.273674 L181.71353,80.7909097 L48.5631521,4.50316009 C43.5539929,1.56944036 37.8568091,0.0156629668 32.0517989,0 C17.6444261,-0.0284873284 4.97836875,9.53420553 1.0599006,23.3985055 L120.436101,141.273674 Z" fill="#34A853" />
        </svg>
      )}
      <span class="store-copy">
        {!compact && <span class:list={["store-kicker", { "store-kicker--google": isGooglePlay }]}>{isAppStore ? "Download on the" : "Get it on"}</span>}
        <span class="store-name">{label}</span>
      </span>
    </>
  ) : (
    <>
      <span>{label}</span>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M7 17 17 7M7 7h10v10" />
      </svg>
    </>
  )}
</a>

<style>
  .project-link {
    display: inline-flex;
    min-height: 3rem;
    max-width: 100%;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    gap: 0.625rem;
    border: 1px solid #dbe0e7;
    border-radius: 0.75rem;
    padding: 0.375rem 0.875rem;
    background: #fff;
    color: #334155;
    font-size: 0.8125rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 180ms ease, border-color 180ms ease, color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .project-link:hover {
    box-shadow: 0 6px 16px -8px rgb(15 23 42 / 0.3);
    transform: translateY(-2px);
  }

  .project-link:active {
    transform: translateY(0);
  }

  .project-link--github,
  .project-link--compact {
    min-height: 1.75rem;
    gap: 0.375rem;
    border-radius: 0.5rem;
    padding: 0.25rem 0.625rem;
    font-size: 0.75rem;
  }

  .project-link--github {
    color: #18181b;
  }

  .project-link--compact:hover {
    transform: none;
  }

  .project-link--github:hover {
    border-color: #18181b;
    background: #18181b;
    color: #fff;
    transform: none;
  }

  .project-link--store {
    justify-content: flex-start;
    border-color: #e2e8f0;
    background: #f8fafc;
    color: #334155;
  }

  .project-link--store:hover {
    border-color: #bfdbfe;
    background: #eff6ff;
    color: #1d4ed8;
    box-shadow: 0 6px 16px -8px rgb(37 99 235 / 0.2);
  }

  .github-icon,
  .store-icon {
    flex-shrink: 0;
  }

  .store-copy {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: left;
  }

  .store-kicker {
    color: #64748b;
    font-size: 0.5625rem;
    font-weight: 400;
    letter-spacing: 0.015em;
    line-height: 1;
  }

  .store-kicker--google {
    font-size: 0.5rem;
    font-weight: 500;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .store-name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.15;
  }

  .project-link--compact .store-name {
    font-size: inherit;
    letter-spacing: normal;
    line-height: 1;
  }

  .project-link--compact.project-link--store {
    padding-inline: 0.375rem;
  }

  .project-link--website:hover {
    border-color: #94a3b8;
    background: #f8fafc;
    color: #0f172a;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-link {
      transition: none;
    }

    .project-link:hover,
    .project-link:active {
      transform: none;
    }
  }
</style>
