---
import SiteLayout from "../layouts/SiteLayout.astro";
import Hero from "../components/home/Hero.astro";
import Skills from "../components/home/Skills.astro";
import Projects from "../components/home/Projects.astro";
import Journey from "../components/home/Journey.astro";
import Life from "../components/home/Life.astro";
import LatestPosts from "../components/home/LatestPosts.astro";
import Contact from "../components/home/Contact.astro";
import { projectGroups } from "../lib/projects";
---

<SiteLayout>
  <Hero />
  {projectGroups.map((group, index) => <Projects group={group} index={(index + 1).toString().padStart(2, "0")} />)}
  <Journey />
  <Skills />
  <LatestPosts />
  <Life />
  <Contact />
</SiteLayout>
