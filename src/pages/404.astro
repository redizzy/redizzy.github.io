---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout title="Page not found | Dizzy" description="This page could not be found. Return to Dizzy's homepage to explore research, software projects, and writing.">
  <section class="mx-auto flex min-h-screen max-w-7xl flex-col items-center justify-center px-6 pb-24 pt-32 text-center sm:px-8">
    <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-blue-600">Page not found</p>
    <h1 class="mt-4 text-8xl font-black tracking-[-0.05em] text-slate-950 sm:text-9xl">404</h1>
    <p class="mt-6 max-w-lg text-base leading-7 text-slate-600 sm:text-lg">The page you're looking for couldn't be found.</p>
    <a href="/" class="mt-8 inline-flex min-h-11 items-center rounded-lg bg-blue-600 px-6 py-3 text-sm font-bold text-white transition hover:bg-blue-700">Back to home</a>
  </section>
</SiteLayout>
